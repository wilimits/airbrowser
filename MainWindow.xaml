<Window x:Class="SearchBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Air Browser" Height="700" Width="1100"
        WindowStyle="SingleBorderWindow" Background="White"
        FontFamily="Segoe UI"
        Icon="app_icon.ico">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaviconStyle" TargetType="Image">
            <Setter Property="Source" Value="{Binding FaviconUri}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FaviconUri}" Value="">
                    <Setter Property="Source" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BookmarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpaceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="true"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4"
                                Margin="0,0,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDeleteMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" x:Name="SidebarColumn" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#F4F4F4" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Sidebar Header / Logo -->
                <Grid Grid.Row="0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                        <Border Background="#111111" CornerRadius="4" Width="20" Height="20">
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <TextBlock Text="Air" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#333333"/>
                    </StackPanel>
                </Grid>

                <!-- Bookmarks List (Top) -->
                <ItemsControl x:Name="BookmarksList" Grid.Row="1" Margin="10,0,10,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BookmarkButtonStyle}" Click="Bookmark_Click" ToolTip="{Binding Title}">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                        <MenuItem Header="Delete Bookmark" Style="{StaticResource ModernDeleteMenuItemStyle}" Click="DeleteBookmark_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="18" Height="18">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#888" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                             <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FaviconUri}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FaviconUri}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Width="18" Height="18" Style="{StaticResource FaviconStyle}" Stretch="UniformToFill"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Space Switcher (Work / Personal) -->
                <Border Grid.Row="2" Margin="10,4,10,10" Background="#E6E6E6" CornerRadius="8" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SpacePersonalBtn" Grid.Column="0" Click="SpacePersonalBtn_Click" Style="{StaticResource SpaceButtonStyle}" Background="White" Foreground="#111111">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Personal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SpaceWorkBtn" Grid.Column="1" Click="SpaceWorkBtn_Click" Style="{StaticResource SpaceButtonStyle}" Background="Transparent" Foreground="#666666">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Work" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tabs List -->
                <ListBox x:Name="TabsList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                         SelectionChanged="TabsList_SelectionChanged" ItemContainerStyle="{StaticResource SidebarListBoxItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#888" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FaviconUri}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FaviconUri}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Width="16" Height="16" Style="{StaticResource FaviconStyle}" Stretch="UniformToFill"/>
                                </Grid>

                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center" Margin="5,0"/>
                                
                                <TextBlock Grid.Column="2" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#888" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Private Tab">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrivate}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                                        Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#888"
                                        Click="CloseTab_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close tab"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- New Tab Button inline -->
                <Button Grid.Row="4" Margin="15,10,15,5" Padding="5" Background="Transparent" BorderThickness="0" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NewTabBtn_Click" Foreground="#999">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="3,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="New tab" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                

                

                
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- URL Bar Area (Serves as Title Bar) -->
            <Grid Grid.Row="0" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="10,4,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ToggleSidebarBtn" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Margin="0,0,10,0"
                            Background="Transparent" BorderThickness="0" Foreground="#555" Click="ToggleSidebarBtn_Click" ToolTip="Toggle Sidebar" WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Margin="0,0,2,0" Grid.Column="1" Background="Transparent" BorderThickness="0" Click="BackButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="ForwardButton" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Margin="0,0,2,0" Grid.Column="2" Background="Transparent" BorderThickness="0" Click="ForwardButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="RefreshButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Margin="0,0,10,0" Grid.Column="3" Background="Transparent" BorderThickness="0" Click="RefreshButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Border Grid.Column="4" HorizontalAlignment="Center" Width="360" Height="28" Background="#F2F3F5" CornerRadius="14" Padding="12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="UrlTextBox" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#333" KeyDown="UrlTextBox_KeyDown" GotFocus="UrlTextBox_GotFocus" LostFocus="UrlTextBox_LostFocus"/>
                            <Button x:Name="BookmarkBtn" Grid.Column="2" Content="&#xE734;" FontFamily="Segoe MDL2 Assets" 
                                    Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#888" 
                                    Click="BookmarkBtn_Click" ToolTip="Add Bookmark"/>
                        </Grid>
                    </Border>

                    <Button x:Name="ReaderBtn" Grid.Column="5" Content="&#xE736;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Margin="5,0,0,0" Background="Transparent" BorderThickness="0" ToolTip="Reading Mode" Click="ReaderBtn_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="SplitBtn" Grid.Column="6" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Margin="2,0,0,0" Background="Transparent" BorderThickness="0" ToolTip="Split View (Side by Side)" Click="SplitBtn_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="SettingsBtn" Grid.Column="7" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Margin="0,0,0,0" Background="Transparent" BorderThickness="0" ToolTip="Settings" Click="SettingsBtn_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-170" VerticalOffset="10">
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,15,15">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.1" ShadowDepth="4" />
                            </Border.Effect>
                            <StackPanel Width="220" Margin="5,5">
                                <Button Style="{StaticResource MenuButtonStyle}" Click="NewPrivateTabBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Margin="5,0,15,0" VerticalAlignment="Center" FontSize="14" Foreground="#888"/>
                                        <TextBlock Text="New private tab" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}" Click="ImportBookmarks_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="5,0,15,0" VerticalAlignment="Center" FontSize="14" Foreground="#888"/>
                                        <TextBlock Text="Import bookmarks" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}" Click="ImportPasswords_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Margin="5,0,15,0" VerticalAlignment="Center" FontSize="14" Foreground="#888"/>
                                        <TextBlock Text="Import passwords" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Rectangle Height="1" Fill="#EEEEEE" Margin="15,5"/>
                                <Button Style="{StaticResource MenuButtonStyle}" Click="DevToolsBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="5,0,15,0" VerticalAlignment="Center" FontSize="14" Foreground="#888"/>
                                        <TextBlock Text="Web Inspector" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" Height="40" Background="Transparent" BorderThickness="0" Click="Minimize_Click"/>
                    <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="46" Height="40" Background="Transparent" BorderThickness="0" Click="Maximize_Click"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="46" Height="40" Background="Transparent" BorderThickness="0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Grid x:Name="WebViewsContainer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" x:Name="LeftCol"/>
                        <ColumnDefinition Width="0" x:Name="SplitterCol"/>
                        <ColumnDefinition Width="0" x:Name="RightCol"/>
                    </Grid.ColumnDefinitions>
                    
                    <GridSplitter x:Name="ViewSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" 
                                  VerticalAlignment="Stretch" Background="#E5E7EB" ShowsPreview="False" Visibility="Collapsed"
                                  ResizeBehavior="PreviousAndNext" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>




