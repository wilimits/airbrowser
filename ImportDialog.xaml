<Window x:Class="SearchBrowser.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Passwords" Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    
    <Border Background="#F9F9FB" CornerRadius="16" BorderBrush="#E5E5E5" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>
        
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="#EEF2FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,15,0">
                    <TextBlock Text="🔑" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </Border>
                <TextBlock Text="Import from Google Chrome" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="To securely import your passwords, follow these steps:" Foreground="#4B5563" FontSize="14" Margin="0,0,0,15"/>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="1." Foreground="#9CA3AF" FontSize="14" FontWeight="Medium"/>
                    <TextBlock Grid.Column="1" Text="Open Google Chrome and go to Settings > Password Manager." Foreground="#374151" FontSize="14" TextWrapping="Wrap"/>
                </Grid>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="2." Foreground="#9CA3AF" FontSize="14" FontWeight="Medium"/>
                    <TextBlock Grid.Column="1" Text="Click the Settings gear icon (or three dots) and select 'Download file'." Foreground="#374151" FontSize="14" TextWrapping="Wrap"/>
                </Grid>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="3." Foreground="#9CA3AF" FontSize="14" FontWeight="Medium"/>
                    <TextBlock Grid.Column="1" Text="Save the .csv file to your computer, then click Continue below." Foreground="#374151" FontSize="14" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Background="Transparent" BorderThickness="0" Foreground="#6B7280" FontSize="14" FontWeight="Medium" Cursor="Hand" Margin="0,0,15,0" Padding="15,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button Content="Continue" Click="Continue_Click" Background="#2563EB" BorderThickness="0" Foreground="White" FontSize="14" FontWeight="Medium" Cursor="Hand" Padding="20,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
